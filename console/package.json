{
  "name": "@stroq/console",
  "version": "0.0.0",
  "private": true,
  "description": "Stroq's local agent security platform: configuration, static review, policy tests and activity investigation.",
  "type": "module",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 47813",
    "build": "pnpm build:engine && next build --webpack",
    "build:engine": "node scripts/build-engine.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "serve:local": "node scripts/serve.mjs",
    "test:local": "node --test scripts/*.test.mjs"
  },
  "dependencies": {
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.61.0",
    "motion": "13.5.1",
    "next": "16.4.2",
    "next-themes": "0.4.6",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwind-merge": "3.7.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
