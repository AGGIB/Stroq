{
  "name": "@stroq/cli",
  "version": "0.29.0",
  "description": "AI agent security platform: local hooks that judge Claude Code, Cursor and Codex tool calls before they run, a console on 127.0.0.1, and checks of past sessions",
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "stroq": "dist/index.js"
  },
  "files": [
    "dist",
    "platform",
    "openclaw-plugin",
    "README.md",
    "LICENSE",
    "DISCLOSURE"
  ],
  "contentPolicy": {
    "class": "dual-use"
  },
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AGGIB/stroq.git",
    "directory": "packages/cli"
  },
  "homepage": "https://stroq.dev",
  "bugs": "https://github.com/AGGIB/stroq/issues",
  "keywords": [
    "ai-agents",
    "agent-security",
    "prompt-injection",
    "claude-code",
    "codex",
    "openclaw",
    "mcp",
    "firewall",
    "cursor",
    "secret-scanning",
    "credential-exposure",
    "llm-security"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "prepack": "node ../../scripts/prepack-platform.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "yaml": "2.9.1",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@stroq/core": "workspace:*"
  }
}
