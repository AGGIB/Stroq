{
  "name": "@stroq/cli",
  "version": "0.16.1",
  "description": "Local action firewall for AI agents: scans what the agent reads, taints the session, blocks dangerous follow-up actions",
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "stroq": "dist/index.js"
  },
  "files": [
    "dist",
    "openclaw-plugin",
    "README.md",
    "LICENSE",
    "DISCLOSURE"
  ],
  "contentPolicy": {
    "class": "dual-use"
  },
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AGGIB/stroq.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/AGGIB/stroq#readme",
  "bugs": "https://github.com/AGGIB/stroq/issues",
  "keywords": [
    "ai-agents",
    "agent-security",
    "prompt-injection",
    "claude-code",
    "mcp",
    "firewall",
    "guardrails",
    "cursor",
    "llm-security"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "prepack": "pnpm -w run build",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "yaml": "2.9.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@stroq/core": "workspace:*"
  }
}
